# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Datasets (regenerate with prepare_text.py / prepare_enwik9.py) ---
# text8/enwik9 are several hundred MB and are downloaded, not authored here.
data/
*.bin
*.zip
*.tar
*.tar.gz

# --- Training artifacts (checkpoints are large; results/*.json are kept) ---
logs/
checkpoints/
*.pth
*.pt

# --- Superseded raster figures (PDF versions are the ones the paper uses) ---
*.png

# --- Paper sources and build chain ---
# The paper lives on arXiv/the journal, not here. This repo is the code and
# data artifact; keeping a second copy of the manuscript only creates drift.
# The build chain goes with it: scripts that reference files absent from the
# repo would only confuse a visitor, and the .sty/.bst files are third-party
# (they belong to the TMLR style repository, not here).
*.tex
refs.bib
tmlr.sty
tmlr.bst
fancyhdr.sty
make_tmlr.py
paketle.py

# --- LaTeX build products ---
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# --- Local working documents, not part of the artifact ---
*.docx
prism_gonderim/
prism_gonderim*.zip
# Turkish working notes and a personal TODO list: superseded by the paper,
# not part of the artifact. The one exception is the experiment inventory,
# which documents what every record in results/ is and why.
notes/*
!notes/DENEYLER.md

# --- Personal operational tooling (no scientific content) ---
# File transfer to a specific cluster account, and SLURM job monitoring.
# The .slurm scripts DO stay: they are the experimental record (grids,
# hyperparameters, and the predictions registered before each run).
gonder.sh
izle.sh

# --- OS ---
.DS_Store
Thumbs.db

# arXiv submission package (rebuilt on demand)
arxiv/
arxiv_submission.zip
tmlr_paket/
tmlr_overleaf.zip
tr_paket/
makale_TR_overleaf.zip

# Gonderim paketleri (paketle.py ile uretilir)
GONDERIM/

# Legacy convenience summary. analiz_tau.py is the single source of truth for
# every number in the paper; summarize.py groups runs differently (per-init)
# and is kept only as a quick browsing aid, so its CSV is not published.
ozet.csv

# Anonim ek materyal paketi (anonim_ek.py ile uretilir; deponun kopyasi)
supplementary_anon/
supplementary_material_anon.zip
ozet_openreview.txt
